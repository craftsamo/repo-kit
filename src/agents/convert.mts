// Converts OpenCode agent definitions (.opencode/agents/<name>.md) into the
// subagent formats of other tools. Frontmatter is not portable across tools,
// so the conversion is lossy on purpose: OpenCode's per-pattern permissions
// are rounded to the nearest coarse posture each tool can express (a tool
// list or a sandbox mode), and the prompt body keeps carrying the detailed
// rules. `model` is never emitted, so each tool uses its own.

import { parseFrontmatter, splitFrontmatter } from "./frontmatter.mts";
import type { YamlMap, YamlValue } from "./frontmatter.mts";

/** Marks a file repo-kit wrote; only such files are replaced or removed. */
export const GENERATED_MARKER = "generated by repo-kit";
// What earlier versions of the same generator wrote, so their files are
// still recognized as generated.
const LEGACY_MARKERS = ["generated by scripts/sync-agents.mjs"];
const GENERATED_NOTE = `${GENERATED_MARKER} — do not edit; edit .opencode/agents/ instead`;

export function isGeneratedText(text: string): boolean {
  return [GENERATED_MARKER, ...LEGACY_MARKERS].some((marker) =>
    text.includes(marker),
  );
}

export interface Capabilities {
  read: boolean;
  grep: boolean;
  glob: boolean;
  list: boolean;
  edit: boolean;
  bash: boolean;
  webfetch: boolean;
  websearch: boolean;
}

export interface Agent {
  name: string;
  description: string;
  body: string;
  capabilities: Capabilities;
  reasoningEffort?: string | undefined;
}

type Effect = "allow" | "ask" | "deny";
interface Rule {
  action: string;
  resource: string;
  effect: Effect;
}

// OpenCode V1 action names, by their V2 names.
const ACTION_ALIASES: Record<string, string> = {
  bash: "shell",
  task: "subagent",
  write: "edit",
  patch: "edit",
};

function isEffect(value: unknown): value is Effect {
  return value === "allow" || value === "ask" || value === "deny";
}

/**
 * The agent a definition describes. Throws when it cannot be converted
 * faithfully: no frontmatter, unsupported YAML, malformed permissions, or no
 * description.
 */
export function parseAgent(raw: string, name: string): Agent {
  const document = splitFrontmatter(raw);
  if (!document) throw new Error("no frontmatter");
  const frontmatter = parseFrontmatter(document.frontmatter);
  const rules = normalizePermissions(frontmatter);
  if (typeof frontmatter.description !== "string" || !frontmatter.description) {
    throw new Error("no description");
  }
  const options = frontmatter.options;
  const effort =
    modelVariant(frontmatter.model) ??
    (isMap(options) && typeof options.reasoningEffort === "string"
      ? options.reasoningEffort
      : undefined);
  return {
    name,
    description: frontmatter.description,
    body: document.body.trim(),
    capabilities: deriveCapabilities(rules),
    reasoningEffort: effort,
  };
}

function isMap(value: YamlValue | undefined): value is YamlMap {
  return typeof value === "object" && value !== null && !Array.isArray(value);
}

// The `#variant` suffix of a `provider/model#variant` reference.
function modelVariant(model: YamlValue | undefined): string | undefined {
  if (typeof model !== "string") return undefined;
  const index = model.indexOf("#");
  return index === -1 ? undefined : model.slice(index + 1) || undefined;
}

// Both permission shapes as one ordered rule list. V2 uses a `permissions`
// array of { action, resource, effect }; the V1 `permission` map, which
// OpenCode still accepts, is flattened in key order.
function normalizePermissions(frontmatter: YamlMap): Rule[] {
  const rules: Rule[] = [];
  const { permissions, permission } = frontmatter;
  if (Array.isArray(permissions)) {
    for (const { action, resource, effect } of permissions) {
      if (
        typeof action !== "string" ||
        typeof resource !== "string" ||
        !isEffect(effect)
      ) {
        throw new Error(
          "each permissions entry needs action, resource, and effect (allow|ask|deny)",
        );
      }
      rules.push({
        action: ACTION_ALIASES[action] ?? action,
        resource,
        effect,
      });
    }
  } else if (isMap(permission)) {
    for (const [action, value] of Object.entries(permission)) {
      const name = ACTION_ALIASES[action] ?? action;
      if (isMap(value)) {
        for (const [resource, effect] of Object.entries(value)) {
          if (!isEffect(effect))
            throw new Error(`invalid effect for ${action}`);
          rules.push({ action: name, resource, effect });
        }
      } else if (isEffect(value)) {
        rules.push({ action: name, resource: "*", effect: value });
      } else {
        throw new Error(`invalid effect for ${action}`);
      }
    }
  }
  return rules;
}

// Rounds the ordered rules (the last match wins; OpenCode's base policy
// allows everything) down to one boolean per capability. A capability is on
// when any of its patterns is `allow` or `ask` after the last blanket `deny`:
// `ask` still shows the tool, and only a blanket `deny` removes it.
function deriveCapabilities(rules: Rule[]): Capabilities {
  const enabled = (capability: string) => {
    let on = true;
    for (const { action, resource, effect } of rules) {
      if (action === "*") {
        if (resource === "*") on = effect !== "deny";
      } else if (action === capability) {
        if (effect !== "deny") on = true;
        else if (resource === "*") on = false;
      }
    }
    return on;
  };
  return {
    read: enabled("read"),
    grep: enabled("grep"),
    glob: enabled("glob"),
    // V2 has no `list` action: directories are listed through `read`.
    list: enabled("list") || enabled("read"),
    edit: enabled("edit"),
    bash: enabled("shell"),
    webfetch: enabled("webfetch"),
    websearch: enabled("websearch"),
  };
}

function frontmatterDocument(
  fields: Record<string, string | string[]>,
  body: string,
): string {
  const lines: string[] = [];
  for (const [key, value] of Object.entries(fields)) {
    if (Array.isArray(value)) {
      lines.push(`${key}:`);
      for (const item of value) lines.push(`  - ${yamlScalar(item)}`);
    } else {
      lines.push(`${key}: ${yamlScalar(value)}`);
    }
  }
  return `---\n# ${GENERATED_NOTE}\n${lines.join("\n")}\n---\n\n${body}\n`;
}

// A plain YAML scalar when that is unambiguous, else a JSON string, since
// every JSON string is a valid YAML double-quoted scalar.
function yamlScalar(value: string): string {
  const plainSafe =
    /^[A-Za-z0-9_][A-Za-z0-9_.,/* -]*$/.test(value) &&
    !value.includes(": ") &&
    !value.includes(" #") &&
    !value.endsWith(" ");
  return plainSafe ? value : JSON.stringify(value);
}

// Claude Code: .claude/agents/<name>.md
// https://code.claude.com/docs/en/subagents
function emitClaude(agent: Agent): string {
  const c = agent.capabilities;
  const tools = [
    ...(c.read ? ["Read"] : []),
    ...(c.grep ? ["Grep"] : []),
    ...(c.glob || c.list ? ["Glob"] : []),
    ...(c.edit ? ["Edit", "Write"] : []),
    ...(c.bash ? ["Bash"] : []),
    ...(c.webfetch ? ["WebFetch"] : []),
    ...(c.websearch ? ["WebSearch"] : []),
  ];
  return frontmatterDocument(
    {
      name: agent.name,
      description: agent.description,
      tools: tools.join(", "),
    },
    agent.body,
  );
}

// Codex CLI: .codex/agents/<name>.toml
// https://developers.openai.com/codex/subagents
const CODEX_REASONING_EFFORTS = new Set([
  "minimal",
  "low",
  "medium",
  "high",
  "xhigh",
]);

function emitCodex(agent: Agent): string {
  const lines = [
    `# ${GENERATED_NOTE}`,
    `name = ${tomlString(agent.name)}`,
    `description = ${tomlString(agent.description)}`,
    `sandbox_mode = ${tomlString(agent.capabilities.edit ? "workspace-write" : "read-only")}`,
  ];
  if (
    agent.reasoningEffort &&
    CODEX_REASONING_EFFORTS.has(agent.reasoningEffort)
  ) {
    lines.push(`model_reasoning_effort = ${tomlString(agent.reasoningEffort)}`);
  }
  lines.push(`developer_instructions = ${tomlMultiline(agent.body)}`);
  return `${lines.join("\n")}\n`;
}

function tomlString(value: string): string {
  return JSON.stringify(value);
}

function tomlMultiline(value: string): string {
  // A TOML multi-line basic string: escape backslashes, then break any `"""`.
  const escaped = value.replaceAll("\\", "\\\\").replaceAll('"""', '""\\"');
  return `"""\n${escaped}\n"""`;
}

// Gemini CLI: .gemini/agents/<name>.md
// https://geminicli.com/docs/core/subagents/
function emitGemini(agent: Agent): string {
  const c = agent.capabilities;
  const tools = [
    ...(c.read ? ["read_file", "read_many_files"] : []),
    ...(c.grep ? ["search_file_content"] : []),
    ...(c.glob ? ["glob"] : []),
    ...(c.list ? ["list_directory"] : []),
    ...(c.edit ? ["write_file", "replace"] : []),
    ...(c.bash ? ["run_shell_command"] : []),
    ...(c.webfetch ? ["web_fetch"] : []),
    ...(c.websearch ? ["google_web_search"] : []),
  ];
  return frontmatterDocument(
    { name: agent.name, description: agent.description, tools },
    agent.body,
  );
}

// Grok Build: .grok/agents/<name>.md
function emitGrok(agent: Agent): string {
  const c = agent.capabilities;
  const tools = [
    ...(c.read ? ["read_file"] : []),
    ...(c.grep ? ["grep"] : []),
    ...(c.glob || c.list ? ["list_dir"] : []),
    ...(c.edit ? ["search_replace"] : []),
    ...(c.bash ? ["run_terminal_command"] : []),
    ...(c.webfetch ? ["web_fetch"] : []),
    ...(c.websearch ? ["web_search"] : []),
  ];
  return frontmatterDocument(
    { name: agent.name, description: agent.description, tools },
    agent.body,
  );
}

// Copilot CLI: .github/agents/<name>.agent.md
// https://docs.github.com/en/copilot/how-tos/copilot-cli/customize-copilot/create-custom-agents-for-cli
// Copilot's tool names differ per surface, so no tool list is emitted; the
// prompt body carries the read-only and scope rules instead.
function emitCopilot(agent: Agent): string {
  return frontmatterDocument(
    { name: agent.name, description: agent.description },
    agent.body,
  );
}

export interface Target {
  dir: string;
  ext: string;
  emit: (agent: Agent) => string;
}

/** Where each tool reads its subagents, from the repository root. */
export const TARGETS: readonly Target[] = [
  { dir: ".claude/agents", ext: ".md", emit: emitClaude },
  { dir: ".codex/agents", ext: ".toml", emit: emitCodex },
  { dir: ".gemini/agents", ext: ".md", emit: emitGemini },
  { dir: ".grok/agents", ext: ".md", emit: emitGrok },
  { dir: ".github/agents", ext: ".agent.md", emit: emitCopilot },
];

{
  "name": "v{version}",
  "tagPrefix": "v",
  "exclude": ["skip-changelog"],
  "major": ["breaking"],
  "titleEscapes": "\\<*_&",
  "categories": [
    { "title": "Breaking Changes", "labels": ["breaking"] },
    { "title": "Features", "labels": ["feature"], "increment": "minor" },
    { "title": "Fixes", "labels": ["fix"] },
    { "title": "Documentation", "labels": ["documentation"] },
    { "title": "Dependencies", "labels": ["dependencies"] },
    { "title": "Other Changes" }
  ]
}
